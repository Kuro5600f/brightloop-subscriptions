<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Customers can create their own portal account at /web/signup (one account per email) -->
    <function model="ir.config_parameter" name="set_param">
        <value>auth_signup.invitation_scope</value>
        <value>b2c</value>
    </function>
    <function model="ir.config_parameter" name="set_param">
        <value>auth_signup.reset_password</value>
        <value>True</value>
    </function>
</odoo>
