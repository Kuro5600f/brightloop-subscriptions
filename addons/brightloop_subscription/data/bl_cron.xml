<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_bl_billing" model="ir.cron">
        <field name="name">Brightloop: run subscription billing</field>
        <field name="model_id" ref="model_bl_subscription"/>
        <field name="state">code</field>
        <field name="code">model._cron_run_billing()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <!-- first automatic run tomorrow night, so the demo can show "Run billing now" on fresh seed data -->
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 02:00:00')"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
