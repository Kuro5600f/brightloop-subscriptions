<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_bl_subscription_portal" model="ir.rule">
        <field name="name">Portal: own subscriptions only</field>
        <field name="model_id" ref="model_bl_subscription"/>
        <field name="domain_force">[('partner_id', 'child_of', [user.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="rule_bl_subscription_line_portal" model="ir.rule">
        <field name="name">Portal: own subscription lines only</field>
        <field name="model_id" ref="model_bl_subscription_line"/>
        <field name="domain_force">[('subscription_id.partner_id', 'child_of', [user.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
</odoo>
