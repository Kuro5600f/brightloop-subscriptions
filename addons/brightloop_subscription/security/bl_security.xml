<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_brightloop" model="ir.module.category">
        <field name="name">Brightloop</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_bl_staff" model="res.groups">
        <field name="name">Staff</field>
        <field name="category_id" ref="module_category_brightloop"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <record id="group_bl_admin" model="res.groups">
        <field name="name">Admin</field>
        <field name="category_id" ref="module_category_brightloop"/>
        <field name="implied_ids" eval="[(4, ref('group_bl_staff')), (4, ref('account.group_account_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
