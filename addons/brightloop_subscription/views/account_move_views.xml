<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bl_move_form" model="ir.ui.view">
        <field name="name">account.move.form.brightloop</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_origin']" position="before">
                <field name="bl_subscription_id" invisible="not bl_subscription_id"/>
                <field name="bl_period_start" invisible="not bl_subscription_id"/>
            </xpath>
        </field>
    </record>

    <record id="bl_invoice_list" model="ir.ui.view">
        <field name="name">account.move.list.brightloop</field>
        <field name="model">account.move</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="bl_subscription_id"/>
                <field name="bl_period_start"/>
                <field name="invoice_date"/>
                <field name="invoice_date_due" widget="remaining_days" invisible="payment_state in ('paid', 'in_payment', 'reversed')"/>
                <field name="amount_total_signed" string="Total" sum="Total"/>
                <field name="amount_residual_signed" string="Amount Due" sum="Amount Due"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge" string="Status"
                       decoration-muted="state == 'draft'" decoration-info="state == 'posted'"
                       decoration-danger="state == 'cancel'"/>
                <field name="payment_state" widget="badge" string="Payment"
                       decoration-danger="payment_state == 'not_paid'"
                       decoration-warning="payment_state == 'partial'"
                       decoration-success="payment_state in ('paid', 'in_payment')"/>
            </list>
        </field>
    </record>

    <record id="bl_invoice_search" model="ir.ui.view">
        <field name="name">account.move.search.brightloop</field>
        <field name="model">account.move</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="bl_overdue" string="Overdue"
                        domain="[('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial')), ('invoice_date_due', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="bl_outstanding" string="Outstanding"
                        domain="[('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial'))]"/>
                <filter name="bl_partial" string="Partially Paid" domain="[('payment_state', '=', 'partial')]"/>
                <filter name="bl_paid" string="Paid" domain="[('payment_state', 'in', ('paid', 'in_payment'))]"/>
            </xpath>
        </field>
    </record>

    <record id="action_bl_invoices" model="ir.actions.act_window">
        <field name="name">Subscription Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="bl_invoice_list"/>
        <field name="search_view_id" ref="bl_invoice_search"/>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('bl_subscription_id', '!=', False)]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
    </record>

    <record id="action_bl_overdue" model="ir.actions.act_window">
        <field name="name">Overdue Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="bl_invoice_list"/>
        <field name="search_view_id" ref="bl_invoice_search"/>
        <field name="domain">[('move_type', '=', 'out_invoice')]</field>
        <field name="context">{'search_default_bl_overdue': 1}</field>
    </record>

    <record id="action_bl_run_billing" model="ir.actions.server">
        <field name="name">Run billing now</field>
        <field name="model_id" ref="model_bl_subscription"/>
        <field name="binding_model_id" ref="model_bl_subscription"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = model.action_run_billing()</field>
    </record>
</odoo>
