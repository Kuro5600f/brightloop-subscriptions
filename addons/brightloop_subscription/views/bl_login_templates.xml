<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Shared shell for login, sign-up and reset pages: animated art panel + form panel -->
    <template id="login_layout_bl" inherit_id="web.login_layout" priority="99">
        <xpath expr="//t[@t-set='body_classname']" position="attributes">
            <attribute name="t-value">'bl-auth-body'</attribute>
        </xpath>
        <xpath expr="//div[hasclass('container')]" position="replace">
            <!-- set theme before first paint: saved choice, else system preference -->
            <script>
                (function () {
                    var t = null;
                    try { t = localStorage.getItem('bl-theme'); } catch (e) {}
                    if (t !== 'dark' &amp;&amp; t !== 'light') {
                        t = window.matchMedia &amp;&amp; window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                    }
                    document.documentElement.setAttribute('data-bl-theme', t);
                })();
            </script>
            <main class="bl-auth">
                <button type="button" class="bl-theme-toggle" aria-label="Switch to dark mode" title="Switch theme">
                    <i class="fa fa-moon-o bl-icon-moon" aria-hidden="true"/>
                    <i class="fa fa-sun-o bl-icon-sun" aria-hidden="true"/>
                </button>
                <div class="bl-auth-card">
                    <section class="bl-auth-art" aria-hidden="true">
                        <div class="bl-anim bl-anim-active" data-bl-anim=""/>
                        <div class="bl-art-copy">
                            <p class="bl-art-welcome">WELCOME</p>
                            <p class="bl-art-tag">Plans, subscriptions and recurring billing in one calm place.</p>
                        </div>
                    </section>
                    <section class="bl-auth-panel">
                        <div class="bl-brand">
                            <span class="bl-brand-mark" aria-hidden="true">b</span>
                            <span class="bl-brand-name">Brightloop</span>
                        </div>
                        <t t-out="0"/>
                        <p class="bl-auth-foot" t-if="not disable_footer">
                            <a t-if="not disable_database_manager" href="/web/database/manager">Manage databases</a>
                        </p>
                    </section>
                </div>
            </main>
        </xpath>
    </template>

    <!-- Login form: keep every Odoo field and hook; add heading, validation hooks, password toggle, loading state -->
    <template id="login_bl" inherit_id="web.login" priority="99">
        <xpath expr="//form[@role='form']" position="before">
            <header class="bl-auth-head">
                <h1 class="bl-auth-title">Welcome back</h1>
                <p class="bl-auth-sub">Sign in to manage your subscriptions and invoices.</p>
            </header>
        </xpath>
        <xpath expr="//form[@role='form']" position="attributes">
            <attribute name="novalidate">novalidate</attribute>
        </xpath>
        <xpath expr="//input[@name='login']" position="attributes">
            <attribute name="placeholder">you@company.com</attribute>
            <attribute name="inputmode">email</attribute>
            <attribute name="aria-describedby">bl_login_err</attribute>
        </xpath>
        <xpath expr="//input[@name='login']" position="after">
            <p class="bl-field-error" id="bl_login_err" aria-live="polite"/>
        </xpath>
        <xpath expr="//input[@name='password']" position="attributes">
            <attribute name="placeholder">Your password</attribute>
            <attribute name="aria-describedby">bl_password_err bl_caps</attribute>
        </xpath>
        <xpath expr="//input[@name='password']" position="after">
            <button type="button" class="bl-pass-toggle" aria-label="Show password" aria-pressed="false" aria-controls="password">
                <i class="fa fa-eye" aria-hidden="true"/>
            </button>
            <p class="bl-caps" id="bl_caps" hidden="hidden"><i class="fa fa-arrow-up" aria-hidden="true"/> Caps Lock is on</p>
            <p class="bl-field-error" id="bl_password_err" aria-live="polite"/>
        </xpath>
        <xpath expr="//div[hasclass('oe_login_buttons')]/button[@type='submit']" position="replace">
            <button type="submit" class="btn btn-primary bl-submit">
                <span class="bl-submit-label">Log in</span>
                <span class="bl-spinner" aria-hidden="true"/>
            </button>
        </xpath>
        <xpath expr="//form[@role='form']" position="after">
            <details class="bl-demo">
                <summary>Demo accounts</summary>
                <ul>
                    <li><button type="button" class="bl-demo-fill" data-login="admin@brightloop.test">Admin</button> admin@brightloop.test</li>
                    <li><button type="button" class="bl-demo-fill" data-login="staff@brightloop.test">Staff</button> staff@brightloop.test</li>
                    <li><button type="button" class="bl-demo-fill" data-login="customer@acme.test">Customer</button> customer@acme.test</li>
                </ul>
                <p>Password for all: <code>Brightloop#2026</code></p>
            </details>
        </xpath>
    </template>
</odoo>
