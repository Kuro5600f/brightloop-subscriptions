<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bl_plan_list" model="ir.ui.view">
        <field name="name">bl.plan.list</field>
        <field name="model">bl.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="billing_period"/>
                <field name="min_qty"/>
                <field name="date_start"/>
                <field name="date_end"/>
            </list>
        </field>
    </record>

    <record id="bl_plan_form" model="ir.ui.view">
        <field name="name">bl.plan.form</field>
        <field name="model">bl.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. Monthly"/></h1></div>
                    <group>
                        <group string="Billing">
                            <field name="billing_period"/>
                            <field name="min_qty"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group string="Lifecycle">
                            <field name="auto_close"/>
                            <field name="allow_early_close"/>
                            <field name="allow_pause"/>
                            <field name="allow_renew"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bl_plan" model="ir.actions.act_window">
        <field name="name">Plans</field>
        <field name="res_model">bl.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
