<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bl_quote_template_list" model="ir.ui.view">
        <field name="name">bl.quote.template.list</field>
        <field name="model">bl.quote.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="plan_id"/>
                <field name="validity_days"/>
            </list>
        </field>
    </record>

    <record id="bl_quote_template_form" model="ir.ui.view">
        <field name="name">bl.quote.template.form</field>
        <field name="model">bl.quote.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. CRM Starter"/></h1></div>
                    <group>
                        <field name="plan_id"/>
                        <field name="validity_days"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="quantity"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bl_quote_template" model="ir.actions.act_window">
        <field name="name">Quotation Templates</field>
        <field name="res_model">bl.quote.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
